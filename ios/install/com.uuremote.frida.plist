<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.uuremote.frida</string>
  <key>ProgramArguments</key>
  <array>
    <string>/var/jb/usr/sbin/frida-server</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>StandardOutPath</key><string>/var/jb/var/log/frida-server.log</string>
  <key>StandardErrorPath</key><string>/var/jb/var/log/frida-server.log</string>
</dict>
</plist>
