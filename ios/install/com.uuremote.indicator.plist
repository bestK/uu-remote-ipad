<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.uuremote.indicator</string>
  <key>ProgramArguments</key>
  <array>
    <string>/var/jb/usr/local/lib/UUStatusHUD.app/UUStatusHUD</string>
    <string>--daemon</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>/var/root</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>Umask</key><integer>18</integer>
  <key>StandardOutPath</key><string>/var/jb/var/log/uu-indicator.log</string>
  <key>StandardErrorPath</key><string>/var/jb/var/log/uu-indicator.log</string>
</dict>
</plist>
